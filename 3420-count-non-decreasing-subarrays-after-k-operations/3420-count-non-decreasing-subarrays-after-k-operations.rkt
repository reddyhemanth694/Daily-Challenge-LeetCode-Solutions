#|
Brute Force

(define/contract (count-non-decreasing-subarrays nums k)
  (-> (listof exact-integer?) exact-integer? exact-integer?)
  (define v (list->vector nums))
  (define n (vector-length v))
  (for/sum ([l (in-range n)])
    (let loop ([r l] [mx 0] [cost 0] [cnt 0])
      (if (= r n)
          cnt
          (let* ([m (max mx (vector-ref v r))]
                 [c (+ cost (- m (vector-ref v r)))])
            (if (> c k) cnt (loop (add1 r) m c (add1 cnt))))))))
|#

#|
Better Approach

(define/contract (count-non-decreasing-subarrays nums k)
  (-> (listof exact-integer?) exact-integer? exact-integer?)
  (define v (list->vector nums))
  (define n (vector-length v))
  (define lg (integer-length n))
  (define pre (make-vector (add1 n) 0))
  (for ([i (in-range n)])
    (vector-set! pre (add1 i) (+ (vector-ref pre i) (vector-ref v i))))
  (define nxt (make-vector (add1 n) n))
  (for/fold ([st '()]) ([i (in-range (sub1 n) -1 -1)])
    (define s (dropf st (lambda (j) (<= (vector-ref v j) (vector-ref v i)))))
    (vector-set! nxt i (if (null? s) n (car s)))
    (cons i s))
  (define up (make-vector lg nxt))
  (define sm (make-vector lg #f))
  (vector-set! sm 0 (for/vector #:length (add1 n) ([i (in-range (add1 n))])
                      (if (= i n)
                          0
                          (- (* (vector-ref v i) (- (vector-ref nxt i) i))
                             (- (vector-ref pre (vector-ref nxt i)) (vector-ref pre i))))))
  (for ([j (in-range 1 lg)])
    (define pu (vector-ref up (sub1 j)))
    (define ps (vector-ref sm (sub1 j)))
    (vector-set! up j (for/vector #:length (add1 n) ([i (in-range (add1 n))])
                        (vector-ref pu (vector-ref pu i))))
    (vector-set! sm j (for/vector #:length (add1 n) ([i (in-range (add1 n))])
                        (+ (vector-ref ps i) (vector-ref ps (vector-ref pu i))))))
  (for/sum ([l (in-range n)])
    (define-values (cur acc)
      (for/fold ([cur l] [acc 0]) ([j (in-range (sub1 lg) -1 -1)])
        (if (and (< cur n) (<= (+ acc (vector-ref (vector-ref sm j) cur)) k))
            (values (vector-ref (vector-ref up j) cur) (+ acc (vector-ref (vector-ref sm j) cur)))
            (values cur acc))))
    (if (= cur n)
        (- n l)
        (let loop ([lo cur] [hi (sub1 (vector-ref nxt cur))])
          (if (>= lo hi)
              (+ (- lo l) 1)
              (let ([mid (quotient (+ lo hi 1) 2)])
                (if (<= (- (+ acc (* (vector-ref v cur) (+ (- mid cur) 1)))
                           (- (vector-ref pre (add1 mid)) (vector-ref pre cur)))
                        k)
                    (loop mid hi)
                    (loop lo (sub1 mid)))))))))
|#

(define/contract (count-non-decreasing-subarrays nums k)
  (-> (listof exact-integer?) exact-integer? exact-integer?)
  (define v (list->vector nums))
  (define n (vector-length v))
  (define dq (make-vector n 0))
  (for/fold ([head n] [tail n] [r (sub1 n)] [cost 0] [ans 0] #:result ans) ([l (in-range (sub1 n) -1 -1)])
    (define x (vector-ref v l))
    (define-values (h c1)
      (let loop ([h head] [c cost])
        (if (and (< h tail) (<= (vector-ref v (vector-ref dq h)) x))
            (let* ([i (vector-ref dq h)]
                   [stop (if (< (add1 h) tail) (vector-ref dq (add1 h)) (add1 r))])
              (loop (add1 h) (+ c (* (- x (vector-ref v i)) (- stop i)))))
            (values h c))))
    (vector-set! dq (sub1 h) l)
    (define-values (t2 r2 c2)
      (let loop ([t tail] [r r] [c c1])
        (if (<= c k)
            (values t r c)
            (let ([b (vector-ref dq (sub1 t))])
              (loop (if (= b r) (sub1 t) t) (sub1 r) (- c (- (vector-ref v b) (vector-ref v r))))))))
    (values (sub1 h) t2 r2 c2 (+ ans (- r2 l) 1))))