#|
Brute Force

(define/contract (count-servers n logs x queries)
  (-> exact-integer? (listof (listof exact-integer?)) exact-integer? (listof exact-integer?) (listof exact-integer?))
  (for/list ([q queries])
    (define seen (make-hash))
    (for ([lg logs])
      (define t (second lg))
      (when (and (>= t (- q x)) (<= t q))
        (hash-set! seen (first lg) #t)))
    (- n (hash-count seen))))
|#

#|
Better Approach

(define/contract (count-servers n logs x queries)
  (-> exact-integer? (listof (listof exact-integer?)) exact-integer? (listof exact-integer?) (listof exact-integer?))
  (define lg (list->vector (sort logs < #:key second)))
  (define m (vector-length lg))
  (define stamp (make-vector (add1 n) -1))
  (define (lower-bound v)
    (let loop ([lo 0] [hi m])
      (if (>= lo hi)
          lo
          (let ([mid (quotient (+ lo hi) 2)])
            (if (< (second (vector-ref lg mid)) v) (loop (add1 mid) hi) (loop lo mid))))))
  (for/list ([q queries] [i (in-naturals)])
    (let loop ([j (lower-bound (- q x))] [cnt 0])
      (if (and (< j m) (<= (second (vector-ref lg j)) q))
          (let ([s (first (vector-ref lg j))])
            (if (= (vector-ref stamp s) i)
                (loop (add1 j) cnt)
                (begin (vector-set! stamp s i) (loop (add1 j) (add1 cnt)))))
          (- n cnt)))))
|#

(define/contract (count-servers n logs x queries)
  (-> exact-integer? (listof (listof exact-integer?)) exact-integer? (listof exact-integer?) (listof exact-integer?))
  (define lg (list->vector (sort logs < #:key second)))
  (define m (vector-length lg))
  (define qv (list->vector queries))
  (define order (sort (range (vector-length qv)) < #:key (lambda (i) (vector-ref qv i))))
  (define cnt (make-vector (add1 n) 0))
  (define ans (make-vector (vector-length qv) 0))
  (for/fold ([l 0] [r 0] [distinct 0]) ([i order])
    (define q (vector-ref qv i))
    (define-values (r1 d1)
      (let loop ([r r] [d distinct])
        (if (and (< r m) (<= (second (vector-ref lg r)) q))
            (let ([s (first (vector-ref lg r))])
              (vector-set! cnt s (add1 (vector-ref cnt s)))
              (loop (add1 r) (if (= (vector-ref cnt s) 1) (add1 d) d)))
            (values r d))))
    (define-values (l1 d2)
      (let loop ([l l] [d d1])
        (if (and (< l r1) (< (second (vector-ref lg l)) (- q x)))
            (let ([s (first (vector-ref lg l))])
              (vector-set! cnt s (sub1 (vector-ref cnt s)))
              (loop (add1 l) (if (= (vector-ref cnt s) 0) (sub1 d) d)))
            (values l d))))
    (vector-set! ans i (- n d2))
    (values l1 r1 d2))
  (vector->list ans))